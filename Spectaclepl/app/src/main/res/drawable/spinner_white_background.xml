<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#3A3A3A"/>
                    <corners android:radius="4dp"/>
                    <stroke android:width="1dp" android:color="#555555"/>
                </shape>
            </item>
            <item android:gravity="end|center_vertical" android:right="8dp">
                <bitmap android:src="@android:drawable/arrow_down_float" android:tint="@android:color/white"/>
            </item>
        </layer-list>
    </item>
</selector>