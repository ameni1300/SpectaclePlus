<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="733dp"
    android:background="#1C1C1E"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Titre principal -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-10dp"
            android:layout_marginStart="35dp"
            android:text="Bienvenue à "
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold" />

        <!-- Logo Spectacle+ -->
        <ImageView
            android:id="@+id/spectacle_logo"
            android:layout_width="285dp"
            android:layout_height="100dp"
            android:layout_gravity="end"
            android:layout_marginTop="-30dp"
            android:src="@drawable/logo" />

        <!-- Champs de saisie -->


        <EditText
            android:id="@+id/username_input"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:hint="Nom d'utilisateur"
            android:background="@drawable/edittext_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:hint="E-mail"
            android:inputType="textEmailAddress"
            android:drawablePadding="10dp"
            android:drawableTint="#CD3E10"
            android:background="@drawable/edittext_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:hint="Mot de passe"
            android:inputType="textPassword"
            android:background="@drawable/edittext_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="20dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/name_input"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="0dp"
            android:hint="Telephone"
            android:background="@drawable/edittext_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="16sp" />

        <!-- Bouton Créer un compte -->
        <Button
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:backgroundTint="#CD3E10"
            android:text="Créer un compte"
            android:textColor="#FFFFFF"
            android:padding="20dp"
            android:textSize="20sp" />

        <!-- Lien pour se connecter -->
        <TextView
            android:id="@+id/text_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_gravity="center_horizontal"
            android:text="Vous avez déjà un compte ? Connectez-vous"
            android:textColor="#FF5722"
            android:textSize="16sp" />

        <!-- Image en bas -->
        <ImageView
            android:id="@+id/logo_img"
            android:layout_width="360dp"
            android:layout_height="150dp"
            android:layout_marginLeft="-22dp"
            android:layout_marginTop="-15dp"
            android:layout_marginBottom="-50dp"
            android:src="@drawable/img_11" />
        <ImageView
            android:id="@+id/logo_1"
            android:layout_width="260dp"
            android:layout_height="90dp"
            android:layout_marginLeft="31dp"
            android:layout_marginTop="-75dp"
            android:src="@drawable/img_13" />

    </LinearLayout>
</ScrollView>
