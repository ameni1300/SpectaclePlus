<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1E"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Titre principal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp"
            android:text="Réinitialisation du mot de passe"
            android:textColor="#FFFFFF"

            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Champ Nouveau mot de passe -->
        <EditText
            android:id="@+id/et_new_password"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:hint="Nouveau mot de passe"
            android:inputType="textPassword"
            android:background="@drawable/edittext_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="16sp"/>

        <!-- Champ Confirmation mot de passe -->
        <EditText
            android:id="@+id/et_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:hint="Confirmer le mot de passe"
            android:inputType="textPassword"
            android:background="@drawable/edittext_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="16sp"/>

        <!-- Bouton Réinitialiser -->
        <Button
            android:id="@+id/btn_reset_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:backgroundTint="#CD3E10"
            android:text="Réinitialiser"
            android:textColor="#FFFFFF"
            android:padding="15dp"
            android:textSize="20sp"/>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:indeterminateTint="#CD3E10"
            android:visibility="gone"/>

        <!-- Image décorative en bas -->
        <ImageView
            android:layout_width="300dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:src="@drawable/img_11"
            android:contentDescription="Décoration"/>
        <ImageView
            android:id="@+id/logo_1"
            android:layout_width="205dp"
            android:layout_height="75dp"
            android:layout_marginLeft="90dp"
            android:layout_marginTop="-110dp"
            android:src="@drawable/img_13" />

    </LinearLayout>
</ScrollView>